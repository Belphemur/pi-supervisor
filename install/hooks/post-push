#!/bin/sh
# pi-supervisor: post-push hook (ADR-0012 follow-up).
#
# A push is the honest trigger for "the PR may have gained review findings".
# Bots re-review the whole diff after every push, so a campaign that closed
# clean minutes ago can attract new threads — with no live round to answer
# them, because the campaign is one-shot by design and every review verb
# requires one.
#
# This hook asks the daemon to compare the PR's open-thread count against the
# baseline recorded when the campaign ended, and reports the verdict. The
# daemon emits review_threads_appeared when the count rose.
#
# Deliberately NOT a poller: it runs on push, which is a real event. A watcher
# that re-listed threads on a timer would burn API quota forever and violate
# the push-only delivery rule (AGENTS.md invariant 6).
#
# Installed by install.sh. Safe to delete: the supervisor falls back to the
# end-of-round trigger and `pi-supervisor review <job> --recheck`.

command -v pi-supervisor >/dev/null 2>&1 || {
  echo "pi-supervisor: not on PATH; skipping review re-check" >&2
  exit 0
}

# Which remote was pushed (git passes them as arguments to post-push).
remote_name=$1
if [ -n "$remote_name" ] && [ "$remote_name" != "origin" ]; then
  echo "pi-supervisor: push to '$remote_name' (not origin); skipping review re-check" >&2
  exit 0
fi

# Best-effort job association: the supervisor knows which jobs point at this
# worktree. Ask it for every job's re-check and let it decide which have a
# baseline. `--all` is a single daemon round-trip rather than one per job.
pi-supervisor review-recheck --pushed >/dev/null 2>&1 || {
  # A failure here must NEVER fail the push: the hook is advisory, and
  # blocking a developer's push on a review check would be a serious bug.
  echo "pi-supervisor: review re-check failed (non-fatal); run 'pi-supervisor review <job> --recheck'" >&2
}

exit 0
